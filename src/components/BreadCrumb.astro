---
import { iconMap } from "./icons/index";
import { hexToRgba, hexToBorder } from "../lib/color.ts";

interface Props {
  name: string;
  color: string;
}

const { name, color } = Astro.props;
const Icon = iconMap[`Icon${name.replace(/[\s.-]/g, "")}`] || iconMap.IconReact;
---

<span
  class="inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-medium transition-all hover:scale-110"
  style="background: {hexToRgba(color, 0.15)}; color: {color}; border: 1px solid {hexToBorder(color)};"
>
  {Icon && <Icon size={12} />}
  {name}
</span>

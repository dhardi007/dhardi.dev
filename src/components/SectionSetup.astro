const setupInterests = [
  { key: 'scriptsCard', img: '/interests/setup-rofi.webp', color: '#00d9ff', badges: ['Bash', 'Rofi', 'Zenity'] },
  { key: 'scripts', img: '/interests/setup-fastfetch.webp', color: '#34d399', badges: ['Bash', 'Python', 'Zsh'] },
  { key: 'blueprint', img: '/interests/setup-nvim.webp', color: '#e94560', badges: ['Bash', 'CSS', 'AI'] },
  { key: 'gallery', img: '/interests/setup-rice.webp', color: '#00d9ff', badges: ['Arch', 'Hyprland', 'EWW'] },
];
---

<section id="interests" class="py-24 px-4 relative overflow-hidden">
  <div class="absolute inset-0 section-bg-1 opacity-60"></div>
  <div class="max-w-5xl mx-auto relative z-10 section-in">
    <h2 class="font-display text-3xl sm:text-4xl font-bold mb-2 text-center">
      <span class="gradient-text">/</span> <span data-i18n="interests.heading">Intereses</span>
    </h2>
    <div class="w-16 h-1 bg-[#e94560] mx-auto mb-4 rounded-full"></div>
    <p class="text-subtle text-center mb-12" data-i18n="interests.subtitle">Gaming · Setup · Dotfiles · Más allá del código</p>

    <!-- Personal interests -->
    <h3 class="font-display text-sm font-semibold tracking-widest uppercase mb-6 text-center" style="color: var(--color-cyan);" data-i18n="interests.personalLabel">// Lo que disfruto</h3>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 mb-14">
      {personalInterests.map(c => (
        <div class="interest-card group rounded-xl overflow-hidden border border-custom bg-[var(--bg-secondary)] transition-all duration-300 hover:-translate-y-1 hover:border-[#00d9ff]/40">
          <div class="relative h-44 overflow-hidden">
            <div class="media-stack" data-carousel>
              {c.imgs.map((src, i) => (
                <img
                  src={src}
                  alt={`${c.key}-${i + 1}`}
                  loading={i === 0 ? 'lazy' : 'lazy'}
                  decoding="async"
                  class:list={['media-img', i === 0 && 'is-active']}
                />
              ))}
            </div>
            {c.video && (
              <>
                <button type="button" class="play-btn" data-tv-play aria-label="Play">
                  <span class="play-circle">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                  </span>
                </button>
                <video class="media-video" hidden preload="metadata" controls playsinline poster={c.imgs[0]} src={c.video}></video>
              </>
            )}
            {c.future && (
              <span class="absolute top-3 right-3 z-20 px-2 py-0.5 text-[10px] font-mono uppercase tracking-wide bg-purple-500/20 text-white border border-purple-400/50 rounded backdrop-blur-sm" style="text-shadow:0 1px 3px rgba(0,0,0,0.85), 0 0 6px rgba(0,0,0,0.5)" data-i18n="interests.futureBadge">Future Interest</span>
            )}
          </div>
          <div class="p-4">
            <p class="font-mono text-[10px] uppercase tracking-widest mb-1.5" style={`color:${c.color}`} data-i18n={`interests.${c.key}Caption`}>caption</p>
            <h3 class="font-display font-bold text-base mb-1" style="color: var(--text-primary);" data-i18n={`interests.${c.key}Title`}>title</h3>
            <p class="text-xs leading-relaxed" style="color: var(--text-muted);" data-i18n={`interests.${c.key}Desc`}>desc</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Setup / dotfiles -->
    <h3 class="font-display text-sm font-semibold tracking-widest uppercase mb-6 text-center" style="color: var(--color-cyan);" data-i18n="interests.setupLabel">// Setup · Dotfiles</h3>
    <div class="grid gap-5 sm:grid-cols-2">
      {setupInterests.map(c => (
        <div class="group rounded-xl overflow-hidden border border-custom bg-[var(--bg-secondary)] transition-all duration-300 hover:-translate-y-1 hover:border-[#00d9ff]/40">
          <div class="relative h-44 overflow-hidden">
            <img src={c.img} alt={c.key} loading="lazy" class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105" />
            <span class="absolute top-3 left-3 px-2 py-0.5 text-[10px] font-mono bg-black/60 text-[#00d9ff] border border-[#00d9ff]/30 rounded backdrop-blur-sm" data-i18n={`interests.${c.key}Caption`}>caption</span>
          </div>
          <div class="p-4">
            <h3 class="font-display font-bold text-base mb-1" style="color: var(--text-primary);" data-i18n={`interests.${c.key}Title`}>title</h3>
            <p class="text-xs leading-relaxed mb-3" style="color: var(--text-muted);" data-i18n={`interests.${c.key}Desc`}>desc</p>
            {c.key === 'gallery' && (
              <a href="https://github.com/dizzi1222/dotfiles-dizzi" target="_blank" class="inline-flex items-center gap-1.5 text-xs text-[#00d9ff] hover:underline">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.604-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
                <span data-i18n="interests.galleryCta">Ver repositorio de dotfiles →</span>
              </a>
            )}
            <div class="flex flex-wrap gap-1.5">
              {c.badges.map(b => (
                <span class="px-2 py-0.5 text-[10px] bg-badge text-[#e94560] rounded font-mono">{b}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .media-stack { position: relative; width: 100%; height: 100%; }
  .media-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.6s ease, transform 0.5s ease;
  }
  .media-img.is-active { opacity: 1; }
  .interest-card:hover .media-img { transform: scale(1.05); }

  .play-btn {
    position: absolute;
    inset: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.35);
    opacity: 0;
    transition: opacity 0.3s ease;
    cursor: pointer;
    border: 0;
    padding: 0;
  }
  .interest-card:hover .play-btn { opacity: 1; }
  .play-circle {
    width: 54px;
    height: 54px;
    border-radius: 9999px;
    background: rgba(233, 69, 96, 0.85);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-left: 4px;
    box-shadow: 0 0 24px rgba(233, 69, 96, 0.5);
    transition: transform 0.25s ease;
  }
  .play-btn:hover .play-circle { transform: scale(1.08); }

  .media-video {
    position: absolute;
    inset: 0;
    z-index: 5;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #000;
  }
  .media-video[hidden] { display: none; }
</style>

<script>
  function initInterestsMedia() {
    document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(stack => {
      const imgs = Array.from(stack.querySelectorAll<HTMLImageElement>('.media-img'));
      if (imgs.length < 2) return;
      const card = stack.closest<HTMLElement>('.interest-card');
      if (!card) return;
      let idx = 0;
      let timer: ReturnType<typeof setInterval> | undefined;

      card.addEventListener('mouseenter', () => {
        timer = setInterval(() => {
          imgs[idx].classList.remove('is-active');
          idx = (idx + 1) % imgs.length;
          imgs[idx].classList.add('is-active');
        }, 1500);
      });

      card.addEventListener('mouseleave', () => {
        clearInterval(timer);
        imgs.forEach(img => img.classList.remove('is-active'));
        idx = 0;
        imgs[0].classList.add('is-active');
      });
    });

    document.querySelectorAll<HTMLElement>('[data-tv-play]').forEach(btn => {
      const media = btn.closest<HTMLElement>('.relative');
      const video = media?.querySelector<HTMLVideoElement>('.media-video');
      if (!video) return;

      btn.addEventListener('click', e => {
        e.stopPropagation();
        btn.hidden = true;
        video.hidden = false;
        video.play().catch(() => {});
      });

      video.addEventListener('ended', () => {
        video.hidden = true;
        video.currentTime = 0;
        btn.hidden = false;
      });
    });
  }

  initInterestsMedia();
</script>

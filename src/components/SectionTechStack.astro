---
import { iconMap } from './icons/index.ts';
import { skills } from '../lib/skills.ts';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
---

<section id="stack" class="py-24 px-4 relative overflow-hidden">
  <div class="bg-dots absolute inset-0"></div>
  <div class="absolute inset-0 section-bg-2 opacity-40"></div>
  <div class="max-w-5xl mx-auto text-center relative z-10 section-in">
    <h2 class="font-display text-3xl sm:text-4xl font-bold mb-2">
      <span class="gradient-text">/</span> <span data-i18n="stack.heading">Tech Stack</span>
    </h2>
    <div class="w-16 h-1 bg-[#e94560] mx-auto mb-4 rounded-full"></div>
    <p class="text-subtle mb-12" data-i18n="stack.subtitle">Tools of the trade</p>

    <div id="skills-grid" class="skills-grid grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3 md:gap-4">
      {
        skills.map((skill) => {
          const IconComponent = iconMap[skill.icon] as AstroComponentFactory | undefined;
          return (
            <article data-skill={skill.name} class="skill-card group relative overflow-hidden rounded-2xl p-3 md:p-5 transition-all duration-500 ease-[cubic-bezier(0.4,0,0.2,1)] cursor-pointer border border-custom/30 hover:border-[{skill.color}]/40" style={`--skill-color: ${skill.color}`}>
              <div class="skill-icon flex flex-col items-center justify-center gap-2 h-full transition-all duration-400 ease-in-out">
                {
                  IconComponent ? (
                    <div class="w-8 h-8 md:w-10 md:h-10" style={`color: ${skill.color}`}>
                      <IconComponent />
                    </div>
                  ) : (
                    <div class="w-8 h-8 md:w-10 md:h-10 rounded bg-badge flex items-center justify-center text-xs text-subtle">?</div>
                  )
                }
                <span class="text-[10px] md:text-xs text-subtle font-medium">{skill.name}</span>
              </div>
              <div class="skill-info absolute inset-0 flex flex-col justify-center items-center gap-2 md:gap-3 p-2 md:p-5 opacity-0 pointer-events-none transition-all duration-300">
                <div class="w-8 h-8 md:w-10 md:h-10 shrink-0" style={`color: ${skill.color}`}>
                  {IconComponent ? <IconComponent /> : null}
                </div>
                <div class="flex flex-col items-center gap-1">
                  <span class="text-xs md:text-sm font-bold" style={`color: ${skill.color}`}>{skill.name}</span>
                  <span class="px-2 py-0.5 rounded text-[10px] font-semibold tracking-wide" style={`background: ${skill.color}18; color: ${skill.color}; border: 1px solid ${skill.color}30`}>{skill.category}</span>
                </div>
                <p class="text-[10px] md:text-xs text-muted leading-relaxed text-center text-pretty line-clamp-3">{skill.description}</p>
                {
                  skill.tags?.length ? (
                    <div class="flex flex-wrap gap-1.5 justify-center">
                      {skill.tags.map((tag) => (
                        <span class="px-1.5 py-0.5 rounded-full text-[9px] font-medium" style={`background: ${skill.color}12; color: ${skill.color}cc; border: 1px solid ${skill.color}20`}>{tag}</span>
                      ))}
                    </div>
                  ) : null
                }
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  const TOTAL_COLS = window.innerWidth < 640 ? 2 : window.innerWidth < 768 ? 3 : 6;
  const grid = document.getElementById('skills-grid')!;
  const cards = grid.querySelectorAll<HTMLElement>('[data-skill]');
  let frozen = false;

  function activate(card: HTMLElement) {
    frozen = true;
    cards.forEach((c) => {
      if (c !== card) {
        c.classList.add('dimmed');
      }
    });
    card.classList.add('is-active');
  }

  function deactivate() {
    frozen = false;
    cards.forEach((c) => {
      c.classList.remove('dimmed', 'is-active');
    });
  }

  grid.addEventListener('mouseover', (e) => {
    const card = (e.target as HTMLElement).closest<HTMLElement>('[data-skill]');
    if (!card) return;
    if (card.classList.contains('is-active')) return;
    deactivate();
    activate(card);
  });

  grid.addEventListener('mouseleave', () => {
    deactivate();
  });
</script>

<style>
  .skill-card { transition: all 0.5s cubic-bezier(0.4,0,0.2,1); }

  .skill-card.dimmed {
    opacity: 0.2;
    transform: scale(0.95);
    pointer-events: none;
  }

  .skill-card.is-active {
    grid-column: span 2 / span 2;
    grid-row: span 2 / span 2;
    z-index: 10;
    border-color: var(--skill-color);
    box-shadow: 0 0 30px color-mix(in srgb, var(--skill-color) 20%, transparent);
  }

  .skill-card.is-active .skill-icon {
    opacity: 0;
  }

  .skill-card.is-active .skill-info {
    opacity: 1;
    pointer-events: auto;
  }

  @media (max-width: 639px) {
    .skill-card.is-active {
      grid-column: span 2 / span 2;
      grid-row: span 1 / span 1;
    }
  }
</style>

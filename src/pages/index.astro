---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import SectionExperience from "../components/SectionExperience.astro";
import SectionProyects from "../components/SectionProyects.astro";
import SectionSetup from "../components/SectionSetup.astro";
import AboutMe from "../components/AboutMe.astro";
import SectionTechStack from "../components/SectionTechStack.astro";
import SectionCertification from "../components/SectionCertification.astro";
import SectionContact from "../components/SectionContact.astro";
import IconGithub from "../components/icons/IconGithub.astro";
import IconLinkedin from "../components/icons/IconLinkedin.astro";
import IconGmail from "../components/icons/IconGmail.astro";
import IconWhatsapp from "../components/icons/IconWhatsapp.astro";
import IconDevto from "../components/icons/IconDevto.astro";
import IconInstagram from "../components/icons/IconInstagram.astro";
---

<Layout>
  <Header />

  <!-- HERO -->
  <section id="hero" class="relative min-h-screen flex items-center justify-center pt-16 px-4">
    <div class="max-w-6xl mx-auto text-center relative z-10">
      <div class="animate-float inline-block mb-6">
        <div class="w-24 h-24 sm:w-28 sm:h-28 mx-auto rounded-full border-2 border-[#e94560] overflow-hidden glow">
          <img src="/avatar.png" alt="Diego Härdi" class="w-full h-full object-cover" />
        </div>
      </div>

      <div class="flex flex-wrap justify-center items-center gap-3 mb-5 animate-fade-in-up">
        <span class="flex items-center gap-2 px-4 py-1.5 bg-[#00d9ff]/10 border border-[#00d9ff]/20 rounded-full text-[#00d9ff] text-xs font-medium">
          <span class="w-1.5 h-1.5 bg-[#00d9ff] rounded-full animate-pulse-soft"></span>
          <span data-i18n="hero.available">Disponible para oportunidades</span>
        </span>
        <a href="/cv.pdf" target="_blank" class="px-4 py-1.5 border border-[#e94560] text-[#e94560] text-xs font-semibold rounded-full hover:bg-[#e94560] hover:text-white transition-all cursor-pointer" data-i18n="hero.downloadCv">Descargar CV</a>
      </div>

      <h1 class="font-display text-4xl sm:text-5xl lg:text-7xl font-extrabold mb-3 animate-fade-in-up">
        Diego <span class="gradient-text">Härdi</span>
      </h1>

      <p class="text-lg sm:text-xl text-secondary mb-3 animate-fade-in-up animate-delay-1" data-i18n="hero.title">
        DevOps &amp; Software Engineer
      </p>

      <p class="text-xs sm:text-sm text-tertiary mb-5 animate-fade-in-up animate-delay-1" data-i18n="hero.tagline">
        Full-Stack · Arch Linux · Neovim
      </p>

      <div class="flex flex-wrap justify-center gap-2 mb-8 animate-fade-in-up animate-delay-1">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-badge border border-custom rounded-full text-xs text-secondary font-medium">
          📍 <span data-i18n="hero.base">Base República Dominicana (UTC-4)</span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-badge border border-custom rounded-full text-xs text-secondary font-medium">
          🌐 <span data-i18n="hero.languages">ES · EN (B2) · DE (A2)</span>
        </span>
      </div>

      <div class="mt-8 mb-8 flex justify-center gap-5 animate-fade-in-up animate-delay-2">
        <a href="https://github.com/dizzi1222" target="_blank" class="transition-all hover:scale-110" style="color: var(--text-muted);" aria-label="GitHub">
          <IconGithub size={22} />
        </a>
        <a href="https://www.linkedin.com/in/diego-samuel-h%C3%A4rdi-santana-3a4343428" target="_blank" class="transition-all hover:scale-110" style="color: var(--text-muted);" aria-label="LinkedIn">
          <IconLinkedin size={22} />
        </a>
        <a href="mailto:diegosamuel042@gmail.com" class="transition-all hover:scale-110" style="color: var(--text-muted);" aria-label="Gmail">
          <IconGmail size={22} />
        </a>
        <a href="https://wa.me/18298216385?text=Hola%20Diego%2C%20vi%20tu%20portafolio%20y%20me%20gustar%C3%ADa%20contactarte" target="_blank" class="transition-all hover:scale-110" style="color: var(--text-muted);" aria-label="WhatsApp">
          <IconWhatsapp size={22} />
        </a>
        <a href="https://dev.to/dizzi1222" target="_blank" class="transition-all hover:scale-110" style="color: var(--text-muted);" aria-label="Dev.to">
          <IconDevto size={22} />
        </a>
        <a href="https://www.instagram.com/diego.sam042/" target="_blank" class="transition-all hover:scale-110" style="color: var(--text-muted);" aria-label="Instagram">
          <IconInstagram size={22} />
        </a>
      </div>

      <div class="flex flex-wrap justify-center gap-4 animate-fade-in-up animate-delay-3">
        <a href="#contact" class="px-8 py-3 bg-[#e94560] text-white font-semibold rounded-lg hover:bg-[#d91a3a] transition-all hover-glow" data-i18n="hero.getInTouch">Contáctame</a>
        <button onclick="openCVModal()" class="px-8 py-3 border border-[#e94560] text-[#e94560] font-semibold rounded-lg hover:bg-[#e94560] hover:text-white transition-all cursor-pointer" data-i18n="hero.previewCv">Vista previa CV</button>
      </div>
    </div>

    <div onclick="document.getElementById('experience').scrollIntoView({behavior:'smooth'})" class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 animate-pulse-soft cursor-pointer hover:opacity-70 transition-opacity">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#888" stroke-width="2"><path d="M7 13l5 5 5-5M7 6l5 5 5-5"/></svg>
    </div>
  </section>

  <main>
    <SectionExperience />
    <SectionTechStack />
    <SectionProyects />
    <SectionCertification />
    <AboutMe />
    <SectionSetup />
    <SectionContact />
  </main>

  <!-- Scroll Progress Dots -->
  <nav id="scroll-dots" class="scroll-dots" aria-label="Section navigation">
    <a href="#hero" class="scroll-dot active" data-section="hero"><span class="scroll-dot-tooltip">Home</span></a>
    <a href="#experience" class="scroll-dot" data-section="experience"><span class="scroll-dot-tooltip" data-i18n="nav.experience">Experiencia</span></a>
    <a href="#stack" class="scroll-dot" data-section="stack"><span class="scroll-dot-tooltip" data-i18n="nav.skills">Skills</span></a>
    <a href="#projects" class="scroll-dot" data-section="projects"><span class="scroll-dot-tooltip" data-i18n="nav.projects">Proyectos</span></a>
    <a href="#certifications" class="scroll-dot" data-section="certifications"><span class="scroll-dot-tooltip" data-i18n="nav.certifications">Certificaciones</span></a>
    <a href="#about" class="scroll-dot" data-section="about"><span class="scroll-dot-tooltip" data-i18n="nav.about">Sobre mí</span></a>
    <a href="#interests" class="scroll-dot" data-section="interests"><span class="scroll-dot-tooltip" data-i18n="nav.interests">Intereses</span></a>
    <a href="#contact" class="scroll-dot" data-section="contact"><span class="scroll-dot-tooltip" data-i18n="nav.contact">Contacto</span></a>
  </nav>

  <!-- Project/CV Modal -->
  <div id="modal" class="modal-overlay">
    <div class="modal-backdrop" onclick="closeModal()"></div>
    <div class="modal-container">
      <div class="modal-header">
        <h3 id="modal-title" class="font-display text-xl font-bold text-primary"></h3>
        <button onclick="closeModal()" class="modal-close">&times;</button>
      </div>
      <div id="modal-image" class="modal-image"></div>
      <p id="modal-description" class="mt-4 text-sm text-muted leading-relaxed"></p>
      <div id="modal-footer" class="modal-footer"></div>
    </div>
  </div>

  <!-- Cert Overlay -->
  <div id="cert-overlay" class="cert-overlay">
    <div class="cert-backdrop" onclick="closeCertModal()"></div>
    <div class="cert-content">
      <div class="cert-header">
        <h3 class="font-display text-xl font-bold text-primary">🎓 <span data-i18n="certs.heading">Certificaciones</span></h3>
        <button onclick="closeCertModal()" class="cert-close">&times;</button>
      </div>
      <div class="cert-body">
        <div class="flex items-center justify-between mb-6">
          <span class="font-mono text-xs text-faint bg-badge px-3 py-1 rounded">cic_cert_download.sh</span>
          <span id="cert-status" class="font-mono text-xs text-[#00d9ff]">100%</span>
        </div>
        <div class="grid gap-4">
          <div class="cert-card">
            <div class="flex items-center gap-4 mb-3">
              <span class="text-3xl" id="cert-spinner">◴</span>
              <div>
                <p class="font-display font-bold text-[#00d9ff]" data-i18n="certs.item1Title">CIC Associate Developer</p>
                <p class="text-xs text-muted font-mono" data-i18n="certs.item1Desc">Certificación oficial · Bootcamp Cincinnatus</p>
              </div>
            </div>
            <div class="cert-bar-track">
              <div id="cert-bar" class="cert-bar-fill" style="width:100%"></div>
            </div>
            <div class="flex justify-between text-xs text-faint font-mono mt-1">
              <span data-i18n="certs.progressLabel">Progreso</span>
              <span id="cert-text">Completado ✓ — Proyecto PTD-Talento desarrollado</span>
            </div>
          </div>
          <div class="cert-card opacity-70">
            <div class="flex items-center gap-4">
              <span class="text-2xl">🔜</span>
              <div>
                <p class="font-display font-bold text-primary">AWS Cloud Practitioner</p>
                <p class="text-xs text-muted font-mono">En planificación</p>
              </div>
            </div>
          </div>
          <div class="cert-card opacity-50">
            <div class="flex items-center gap-4">
              <span class="text-2xl">🔜</span>
              <div>
                <p class="font-display font-bold text-primary">Google Cloud Associate</p>
                <p class="text-xs text-muted font-mono">En planificación</p>
              </div>
            </div>
          </div>
        </div>
        <div class="mt-6 text-center">
          <p class="text-xs text-faint font-mono">※ placeholder — actualizar al recibir certificación oficial <span style="animation:blink 1s step-end infinite">_</span></p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script is:inline>
  // ===== i18n =====
  const i18n = {
    es: {
      nav: { experience: 'Experiencia', skills: 'Skills', projects: 'Proyectos', certifications: 'Certificaciones', about: 'Sobre mí', interests: 'Intereses', contact: 'Contacto', available: 'Disponible', resume: 'CV' },
      hero: { available: 'Open to work', title: 'DevOps & Software Engineer', base: 'Base República Dominicana (UTC-4)', languages: 'ES · EN (B2) · DE (A2)', tagline: 'Full-Stack · Arch Linux · Neovim', getInTouch: 'Contáctame', previewCv: 'Vista previa CV', downloadCv: 'Descargar CV' },
      exp: { heading: 'Experiencia', subtitle: 'Mi trayectoria profesional',
        job1: { badge: 'Retail', title: 'Asistente / Cajero', company: 'La Sirena · República Dominicana', period: '2025 — 2026', desc: 'Mi primer contacto con el mundo laboral formal. Trabajar en uno de los supermercados más grandes del país me enseñó cómo funciona realmente un negocio desde adentro: logística, inventario, atención al cliente bajo presión. Pero también vi de cerca lo peor del trabajo físico sin futuro — el agotamiento, la falta de oportunidades reales, el nepotismo. Esa experiencia fue el combustible que encendió mi decisión de salir de ahí y construir una carrera en tecnología.' },
        job2: { badge: 'Educación', title: 'Bootcamp Full-Stack', company: 'Cincinnatus · República Dominicana', period: '2024 — 2026', desc: 'El motor de arranque de mi carrera como programador. Cincinnatus fue el punto de inflexión donde pasé de ser un curioso autodidacta a un desarrollador en formación. Aprendí los fundamentos del desarrollo web full-stack, trabajé en proyectos reales en equipo, y descubrí que la programación no era solo un trabajo — era mi vocación.' },
        job3: { badge: 'Actual', title: 'MERN Stack Developer · DevOps', company: 'Freelance / Proyectos Propios · Arch Linux · Neovim', period: '2024 — Presente', desc: 'Desarrollo full-stack con el stack MERN (MongoDB, Express, React, Node.js). Arquitecturas limpias, APIs RESTful, despliegues con Docker y automatización de flujos. Mi entorno: Arch Linux con Hyprland, Neovim (LazyVim) como editor principal.' },
        job4: { badge: 'Lead Tech', title: 'Marketplace de Talento [PTD-Talento]', company: 'Cincinnatus Institute of Craftsmanship, INC.', period: 'Ene — Oct 2026', desc: 'Desarrollo del proyecto "Marketplace de Talento" [PTD-Talento] con un equipo de 4 desarrolladores. Protagonisé como Lead Tech: agilicé y coordiné exitosamente el desarrollo del producto, actualmente en espera de la pasantía.' }
      },
      proyectos: { heading: 'Proyectos', subtitle: 'Cosas que he construido', code: 'Código', preview: 'Vista previa', more: 'Más proyectos', workspaceDesc: 'MCP things maybe? Workspace con proyectos como submódulos y repos independientes.', workspaceLarge: 'Workspace con proyectos como submódulos y repos independientes. Un monorepo flexible para experimentar con MCP (Model Context Protocol), todo orquestado desde un solo lugar.' },
      interests: {
        heading: 'Intereses', subtitle: 'Gaming · Setup · Dotfiles · Más allá del código',
        personalLabel: '// Lo que disfruto', setupLabel: '// Setup · Dotfiles', futureBadge: 'Future Interest',
        gamingCaption: 'game night', gamingTitle: 'Gaming', gamingDesc: 'Devil May Cry 3 marcó fuertemente mi pubertad y desde ahí amo el Hack N\' Slash. Con Metal Gear desarrollé mayor criterio por las historias —relatos densos y distorsionados— y con Nier Replicant y Automata aprendí a valorar el buen desarrollo y la escritura más allá del gameplay: lloré con las historias de Kaine y Emil. Los videojuegos son otro medio, no simples juegos; lo reafirmé hace poco con el juegazo de Detroit: Become Human. Undertale marcó mi infancia —Toby Fox es un genio pese a su polémica personalidad… ¡y es Developer! De noche me dan Overwatch, Wild Rift, Warframe o Valorant, nada en especial.',
        animeCaption: 'evening watch', animeTitle: 'Anime & Manga', animeDesc: 'Ashita no Joe dejó un legado que dura para siempre. Berserk me acompañó en mi soledad y Griffith me marcó —nunca hizo nada malo—. Soy un hombre sencillo: Dragon Ball y Naruto marcaron mi infancia, aprecio la vieja escuela —el OVA de Kenshin y las miles de interpretaciones que genera Evangelion— y del moderno amé Devilman Crybaby, Dororo, Death Note y Shingeki no Kyojin, casi el mejor de todos los tiempos.',
        tvCaption: 'now streaming', tvTitle: 'TV · Film & Series', tvDesc: 'Del universo de Breaking Bad y Better Call Saul queda un dúo inolvidable: Jesse y el señor White. Game of Thrones me atrapó y hace poco House of the Dragon revivió el hype con el cierre de La danza de los dragones y la culminación de Daemon y Aegon — espero un final igual de horrible jajaja. Odio el mainstream y el cine de superhéroes (quitando The Boys, que también termina horrible); lo mismo pasa en el anime.',
        musicCaption: 'now playing', musicTitle: 'Music', musicDesc: 'Vengo influenciado por la música de mi papá —que sigo escuchando hasta hoy—: una playlist de más de 80.000 canciones con pop, rock y artistas y géneros de todo tipo. Gypsy Kings y su rumba catalana, Daft Punk que es pura magia, hits de soul como Right Down the Line o Baker Street, rock con Send Me An Angel de Scorpions y Du Hast, Boney M, Billy Joel, el genio de Phil Collins con Genesis… Nujabes es la vida misma. Mi gusto es muy diverso y no me descanto por un solo género — últimamente escucho más salsa por culpa de cierta persona…',
        photographyCaption: 'through the lens', photographyTitle: 'Photography', photographyDesc: 'Me gusta moverme y capturar momentos con mi teléfono, o con mi dron cuando viajo.',
        travelCaption: 'boarding soon', travelTitle: 'Travel', travelDesc: 'Me gusta ver la belleza del mundo en primera persona — tengo planeado conocer más del planeta.',
        drawingCaption: 'tablet & pen', drawingTitle: 'Digital Drawing', drawingDesc: 'Empecé a desarrollar el dibujo de niño. Terminé fusionando tecnología con dibujo y ahora dibujo principalmente en mi tablet.',
        scriptsCardCaption: './system_control.sh', scriptsCardTitle: 'System Control', scriptsCardDesc: 'Menú Rofi con 30+ herramientas: gestión de red, bluetooth, audio, power management, screen capture, modo juego, night mode, fixes de XDG Portal y más.',
        scriptsCaption: '$ ./automate.sh --all', scriptsTitle: 'Scripts & Automation', scriptsDesc: '50+ scripts propios: save-point system para rollback de config, scrcpy connect, widget launcher, power modes, Omarchy Package Install, LimpiarCache, Gitaliases y más. Automatización total del ecosistema Arch.',
        blueprintCaption: 'extract_tokens.sh', blueprintTitle: 'Blueprints & Tokens', blueprintDesc: 'Extractor de design tokens desde imágenes: paletas de colores, CSS custom properties, prompts para IA. De la referencia visual a código listo para producción.',
        galleryCaption: 'cat gallery.md', galleryTitle: 'Galería del Setup', galleryDesc: 'Screenshots reales del desktop: Rofi System Control, Fastfetch, Arch Rice y el ecosistema visual completo de dotfiles-dizzi.',
        galleryCta: 'Ver repositorio de dotfiles →'
      },
      about: {
        heading: 'Sobre mí', subtitle: 'De San Pedro al Mundo',
        desc1: 'DevOps & Software Engineer con pasaporte suizo, nacido en San Pedro de Macorís y viviendo en Jarabacoa, RD. Construyo aplicaciones full-stack con el stack MERN y administro infraestructura en la nube.',
        desc2: 'Por el día desarrollo soluciones escalables. Por la noche estoy sumergido en configuraciones de Neovim, optimizando mi Arch Linux Hyprland o automatizando flujos que no deberían existir.',
        desc3: 'Hablo TypeScript, JavaScript, Lua, Python y el idioma de los sistemas limpios y mantenibles.',
        label: { lives: 'Jarabacoa, RD', languages: 'ES · EN (B2) · DE (A2)', os: 'Arch Linux · Hyprland', editor: 'Neovim · LazyVim' }
      },
      stack: { heading: 'Tech Stack', subtitle: 'Tools of the trade', hint: 'Hover over any tool to learn more' },
      certs: { heading: 'Certificaciones', subtitle: 'Credenciales oficiales', placeholderTitle: 'CIC Associate Developer', placeholderDesc: 'Certificación oficial del bootcamp Cincinnatus.', cta: 'Ver detalles', item1Title: 'CIC Associate Developer', item1Desc: 'Certificación oficial · Bootcamp Cincinnatus', progressLabel: 'Progreso', education: 'Educación', completedLabel: 'Completado', inProgressLabel: 'En progreso', coursesCompleted: '5 cursos completados', cicTitle: 'CIC Associate Developer', cicSubtitle: 'Cincinnatus Institute of Craftsmanship', educationTitle: 'Desarrollo de Software v4', educationInstitution: 'Cincinnatus Institute of Craftsmanship — CIC', educationYear: '2025 (Completado)' },
      contact: { heading: 'Contacto', subtitle: 'Construyamos algo juntos', downloadResume: 'Descargar CV (PDF)', connect: 'Conectemos', description: 'Estoy disponible para oportunidades laborales, proyectos freelance o simplemente para conectar con otros desarrolladores.', form: { name: 'Nombre', email: 'Email', message: 'Mensaje', placeholderName: 'Tu nombre', placeholderEmail: 'tu@email.com', placeholderMessage: 'Cuéntame sobre tu proyecto...', send: 'Enviar mensaje' } },
      footer: { terminal: '🖥️ Versión Terminal', backToTop: 'Volver arriba ↑', subtitle: '🇩🇴 San Pedro de Macorís → Jarabacoa · 🇨🇭 Suizo' },
      modal: { cvTitle: 'Diego Härdi · CV', cvPlaceholder: '📄 Placeholder — CV', cvDesc: 'Descarga mi CV para ver experiencia completa, educación y habilidades técnicas.', downloadCv: 'Descargar CV (PDF)', viewCode: 'Ver código', livePreview: 'Live Preview', screenshotPrefix: '🖼️ Screenshot —', private: 'Privado' },
      vibe: [],
      tech: { 'Node.js': 'Runtime JS del lado del servidor. Construyo APIs RESTful y backends escalables con Express.', 'Express': 'Framework minimalista para Node.js. Mi elección para servidores, middleware y APIs limpias.', 'React': 'Librería declarativa de UI. Interfaces interactivas con componentes reutilizables y hooks.', 'MongoDB': 'Base de datos NoSQL. Almacenamiento primario en proyectos MERN con Mongoose.', 'PostgreSQL': 'Base de datos relacional open-source. Para proyectos con esquemas estructurados e integridad referencial.', 'Git': 'Control de versiones esencial. Workflow con ramas, rebase interactivo y commits semánticos.', 'Arch': 'Mi daily driver. Arch Linux + Hyprland, todo configurado desde cero con mis dotfiles.', 'Neovim': 'Editor principal con LazyVim. Plugins personalizados, LSP y flujo 100% teclado.', 'TypeScript': 'Tipado estático para JS. Lo uso en backend y frontend para código más robusto.', 'Docker': 'Contenedores para desarrollo y producción. Entornos reproducibles y deploys consistentes.', 'JavaScript': 'Lenguaje de programación del lado del cliente. Manipulación del DOM, patrones asíncronos y closures.', 'Python': 'Lenguaje de propósito general. Lo uso para scripting, automatización y backend.', 'Tailwind CSS': 'Framework CSS utility-first. Desarrollo rápido con diseño consistente y componentes responsive.', 'Render': 'Plataforma de despliegue cloud. Deploys automáticos desde Git, SSL nativo y escalado sin configuración.', 'Vercel': 'Plataforma de despliegue frontend serverless. Deploys instantáneos desde Git y rendimiento global.', 'Google Cloud': 'Plataforma cloud de Google. Cómputo, almacenamiento y servicios gestionados para apps escalables.', 'Material UI': 'Biblioteca de componentes React basada en Material Design. UI profesional con temas, grids y accesibilidad.', 'Svelte': 'Framework reactivo que compila a JS vanilla. Sin virtual DOM, máximo rendimiento y sintaxis elegante.', 'Astro': 'Framework web para sitios con contenido. Islands Architecture, zero JS por defecto y rendimiento extremo.', 'HTML': 'Lenguaje de marcado para la estructura web. Semántica, accesibilidad y SEO desde la base.', 'CSS': 'Hojas de estilo en cascada. Layouts con Grid/Flexbox, animaciones, variables custom y responsive design.', 'Figma': 'Herramienta de diseño colaborativo. Prototipado, design tokens, auto-layout y sistemas de componentes.', 'Bootstrap': 'Framework CSS con componentes predefinidos. Grid system, utilidades responsive y tema personalizable.', 'Railway': 'Plataforma cloud moderna. Deploy automático, bases de datos gestionadas y escalado sin configuración.', 'React Router': 'Enrutamiento declarativo para React. Navegación SPA con loaders, acciones y data fetching.', 'Antigravity': 'Motor de juego IDLE con física partículas y render 2D custom.', 'Ollama': 'Ejecución local de modelos LLM. Inferencia offline con Llama, Mistral y modelos open-source.' }
    },
    en: {
      nav: { experience: 'Experience', skills: 'Skills', projects: 'Projects', certifications: 'Certifications', about: 'About', interests: 'Interests', contact: 'Contact', available: 'Available for work', resume: 'Resume' },
      hero: { available: 'Open to work', title: 'DevOps & Software Engineer', base: 'Base Dominican Republic (UTC-4)', languages: 'ES · EN (B2) · DE (A2)', tagline: 'Full-Stack · Arch Linux · Neovim', getInTouch: 'Get in touch', previewCv: 'Preview CV', downloadCv: 'Download CV' },
      exp: { heading: 'Experience', subtitle: 'My professional journey',
        job1: { badge: 'Retail', title: 'Assistant / Cashier', company: 'La Sirena · Dominican Republic', period: '2025 — 2026', desc: 'My first contact with the formal working world. Working at one of the largest supermarkets in the country taught me how a business really works from the inside: logistics, inventory, customer service under pressure.' },
        job2: { badge: 'Education', title: 'Full-Stack Bootcamp', company: 'Cincinnatus · Dominican Republic', period: '2024 — 2026', desc: 'The starting engine of my programming career. Cincinnatus was the turning point where I went from a curious self-taught learner to a developer in training. I learned the fundamentals of full-stack web development.' },
        job3: { badge: 'Current', title: 'MERN Stack Developer · DevOps', company: 'Freelance / Own Projects · Arch Linux · Neovim', period: '2024 — Present', desc: 'Full-stack development with the MERN stack (MongoDB, Express, React, Node.js). Clean architectures, RESTful APIs, Docker deployments and workflow automation.' },
        job4: { badge: 'Lead Tech', title: 'Marketplace de Talento [PTD-Talento]', company: 'Cincinnatus Institute of Craftsmanship, INC.', period: 'Jan — Oct 2026', desc: 'Developed the "Marketplace de Talento" [PTD-Talento] project with a team of 4 developers. Led as Lead Tech: successfully streamlined and coordinated the product development; currently awaiting the internship phase.' }
      },
      proyectos: { heading: 'Projects', subtitle: 'Things I\'ve built', code: 'Code', preview: 'Preview', more: 'More projects', workspaceDesc: 'MCP things maybe? Workspace with projects as submodules and standalone repos.', workspaceLarge: 'Workspace with projects as submodules and standalone repos. A flexible monorepo to experiment with MCP (Model Context Protocol), all orchestrated from a single place.' },
      interests: {

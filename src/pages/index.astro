  function switchLanguage(lang) {
    localStorage.setItem('dhardi-lang', lang);
    document.documentElement.lang = lang === 'es' ? 'es' : lang === 'de' ? 'de' : 'en';
    document.querySelectorAll('[data-i18n]').forEach(el => {
      const keys = el.getAttribute('data-i18n').split('.');
      let val = i18n[lang];
      for (const k of keys) { if (val && typeof val === 'object') val = val[k]; else { val = null; break; } }
      if (val && typeof val === 'string') el.textContent = val;
    });
    document.querySelectorAll('[data-i18n-placeholder]').forEach(el => {
      const keys = el.getAttribute('data-i18n-placeholder').split('.');
      let val = i18n[lang];
      for (const k of keys) { if (val && typeof val === 'object') val = val[k]; else { val = null; break; } }
      if (val && typeof val === 'string') el.setAttribute('placeholder', val);
    });
    document.getElementById('current-lang-label').textContent = lang.toUpperCase();
    var floatingLangLabel = document.getElementById('floating-lang-label');
    if (floatingLangLabel) floatingLangLabel.textContent = lang.toUpperCase();
    document.querySelectorAll('.lang-dropdown-item').forEach(item => {
      var lg = item.dataset.lang || '';
      if (lg === lang) {
        item.textContent = lg.toUpperCase() + ' ✓';
        item.style.color = 'var(--text-primary)';
        item.style.fontWeight = '600';
      } else {
        item.textContent = lg.toUpperCase();
        item.style.color = 'var(--text-muted)';
        item.style.fontWeight = '';
      }
    });
    closeLangDropdown();
    var fm = document.getElementById('floating-lang-menu');
    if (fm) fm.classList.add('hidden');
  }

  function toggleLangDropdown() { document.getElementById('lang-dropdown-menu').classList.toggle('hidden'); }
  function closeLangDropdown() { document.getElementById('lang-dropdown-menu').classList.add('hidden'); }

  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeLangDropdown(); });
  document.addEventListener('click', (e) => {
    const dd = document.getElementById('lang-dropdown');
    if (dd && !dd.contains(e.target)) document.getElementById('lang-dropdown-menu').classList.add('hidden');
  });

  function switchTheme(theme) {
    localStorage.setItem('dhardi-theme', theme);
    document.documentElement.setAttribute('data-theme', theme);
    document.querySelectorAll('#theme-dark-btn, #theme-light-btn').forEach(btn => {
      const btnTheme = btn.id.replace('theme-', '').replace('-btn', '');
      if (btnTheme === theme) {
        btn.style.background = 'var(--bg-secondary)';
        btn.style.color = 'var(--text-primary)';
      } else {
        btn.style.background = 'transparent';
        btn.style.color = 'var(--text-muted)';
      }
    });
  }

  function openCVModal() {
    const lang = localStorage.getItem('dhardi-lang') || 'es';
    const t = i18n[lang];
    document.getElementById('modal-title').textContent = t.modal.cvTitle;
    document.getElementById('modal-image').innerHTML = `<iframe src="/cv.pdf" style="width:100%;height:500px;border:none;border-radius:0.75rem;background:var(--bg-secondary);"></iframe>`;
    document.getElementById('modal-description').textContent = t.modal.cvDesc;
    document.getElementById('modal-footer').innerHTML = `<a href="/cv.pdf" target="_blank" class="px-5 py-2 bg-[#e94560] text-white text-sm font-semibold rounded-lg hover:bg-[#d91a3a] transition-all">${t.modal.downloadCv}</a>`;
    document.getElementById('modal').classList.add('active');
    document.body.style.overflow = 'hidden';
  }


    document.body.style.overflow = 'hidden';
  }

  document.addEventListener('keydown', e => { if (e.key === 'Escape') { closeModal(); closeCertModal(); } });

  function toggleMobileNav() {
    document.getElementById('mobile-nav-menu').classList.toggle('open');
    document.getElementById('mobile-nav-backdrop').classList.toggle('open');
    document.getElementById('mobile-nav-toggle').classList.toggle('open');
  }
  function closeMobileNav() {
    document.getElementById('mobile-nav-menu').classList.remove('open');
    document.getElementById('mobile-nav-backdrop').classList.remove('open');
    document.getElementById('mobile-nav-toggle').classList.remove('open');
  }
  document.addEventListener('scroll', closeMobileNav, { passive: true });
  window.addEventListener('resize', () => { if (window.innerWidth >= 768) closeMobileNav(); });

  // ===== Cert Spinner =====
  const certFrames = ['◴', '◷', '◶', '◵'];
  let certIdx = 0;
  setInterval(() => { const el = document.getElementById('cert-spinner'); if (el) el.textContent = certFrames[certIdx++ % certFrames.length]; }, 400);

  // ===== Scroll reveal =====
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => { if (entry.isIntersecting) entry.target.classList.add('visible'); });
  }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
  document.querySelectorAll('.section-in').forEach(el => revealObserver.observe(el));

  // ===== Scroll spy =====
  const navLinks = document.querySelectorAll('nav a[href^="#"]');
  const spySections = document.querySelectorAll('section[id]');
  const spyObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const id = entry.target.id;
        navLinks.forEach(link => {
          link.classList.remove('text-primary');
          link.classList.add('text-muted');
          if (link.getAttribute('href') === '#' + id) {
            link.classList.remove('text-muted');
            link.classList.add('text-primary');
          }
        });
      }
    });
  }, { threshold: 0.3, rootMargin: '0px 0px -100px 0px' });
  spySections.forEach(s => spyObserver.observe(s));

  // ===== Tech Stack interaction (handled via hover in SectionTechStack.astro) =====

  // ===== Header scroll → floating nav (smooth crossfade) =====
  const header = document.getElementById('header');
  const floatingNav = document.getElementById('floating-nav');
  var navTransitioning = false;
  window.addEventListener('scroll', () => {
    var y = window.scrollY;
    if (y > 200 && !header.classList.contains('header-hidden')) {
      header.classList.add('header-hidden');
      setTimeout(() => floatingNav.classList.add('visible'), 150);
    } else if (y <= 120 && header.classList.contains('header-hidden')) {
      floatingNav.classList.remove('visible');
      setTimeout(() => header.classList.remove('header-hidden'), 150);
    }
  }, { passive: true });

  // ===== Scroll dots + floating nav tracking (unified) =====
  const scrollDots = document.querySelectorAll('.scroll-dot');
  const floatingLinks = document.querySelectorAll('.floating-nav-link');
  const allSections = document.querySelectorAll('section[id]');
  var currentSection = '';

  var unifiedObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        currentSection = entry.target.id;
        // Update scroll dots
        scrollDots.forEach(dot => dot.classList.remove('active'));
        var activeDot = document.querySelector('.scroll-dot[data-section="' + currentSection + '"]');
        if (activeDot) activeDot.classList.add('active');
        // Update floating nav links
        floatingLinks.forEach(l => l.classList.remove('active'));
        var activeFloat = document.querySelector('.floating-nav-link[data-section="' + currentSection + '"]');
        if (activeFloat) activeFloat.classList.add('active');
      }
    });
  }, { threshold: 0.15, rootMargin: '-10% 0px -40% 0px' });
  allSections.forEach(s => unifiedObserver.observe(s));

  // ===== Initialize =====
  (function init() {
    const browserLang = navigator.language?.startsWith('de') ? 'de' : navigator.language?.startsWith('en') ? 'en' : 'es';
    const savedLang = localStorage.getItem('dhardi-lang') || browserLang;
    const savedTheme = localStorage.getItem('dhardi-theme') || 'dark';
    switchLanguage(savedLang);
    switchTheme(savedTheme);
  })();
</script>
